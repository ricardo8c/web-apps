% dind, docker

# Listar containers em execução
docker ps

# Listar todos os containers (inclusive parados)
docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"

# Entrar no shell de um container
docker exec -it {{container_name}} /bin/bash

$ container_name: docker ps --format '{{.Names}}'

# Ver logs de um container
docker logs -f --tail {{n}} {{container_name}}

$ container_name: docker ps --format '{{.Names}}'
$ n: 100

# Reiniciar um container
docker restart {{container_name}}

$ container_name: docker ps -a --format '{{.Names}}'

# Remover containers parados
docker container prune -f

# Inspecionar rede de um container
docker inspect {{container_name}} | grep -i ipaddress

$ container_name: docker ps --format '{{.Names}}'

# dind_init com portmap 80,443,9000,3000
docker run --privileged -d -p 80:80 -p 443:443 -p 9000:9000 -p 3000:3000 \
  -v $(pwd):/projeto/app \
  -v $HOME/projetos/dind_share:/projeto/share \
  -v dind_$(basename "$(pwd)")_root:/root \
  -v dind_$(basename "$(pwd)")_volumes:/projeto/volumes \
  -v dind_$(basename "$(pwd)"):/var/lib/docker \
  --restart unless-stopped --name $(basename "$(pwd)") docker
printf "persistir dados em: /projeto/volumes (volume no host: dind_$(basename "$(pwd)")_volumes)\ncompartilhar dados com o host em: /projeto/share (pasta no host ~\projetos\dind_share)\n"
docker exec -it -w /projeto/app $(basename "$(pwd)") /bin/sh

% docker, netshoot
# netshoot in Host network
docker run -it --rm --net host nicolaka/netshoot

# netshoot in a container network
docker run -it --rm --net "container:<container_name>" nicolaka/netshoot

$ container_name: docker ps --format "{{.Names}}"


% docker, stack

# mostrar vars da Stack
export $(grep -v '^#' ../config.env | xargs)
infisical run --env=<oambiente> --path=/web1/deploy/<stack> -- printenv

# Remover Stack
docker stack rm <stack_name>

# Deploy Stack
export $(grep -v '^#' ../config.env | xargs)
infisical run --env=<oambiente> --path=/web1/deploy/<stack> --path=/web1 -- docker stack deploy --prune --resolve-image always -c web1/<stack>.yaml <stack>

$ oambiente: [ -n "$AMBIENTE" ] && echo "$AMBIENTE" || echo "dev staging prod" | tr ' ' '\n'
$ stack: ls web1/*.yaml 2>/dev/null | xargs -n 1 basename | sed 's/\.yaml$//'
$ stack_name: docker stack ls --format '{{.Name}}'


% docker, volumes

# Backup a docker volume
docker run --rm --log-driver none -v "<volume_name>":/volume loomchild/volume-backup backup > "./<volume_name>.tar.bz2"
echo "Backup concluído!"
echo "Arquivo criado: <volume_name>"

$ volume_name: docker volume ls --format "{{.Name}}"

% docker, postgres
# criar novo banco de dados no postgres(local)
docker exec -it $(docker ps -q -f "name=postgres_postgres") createdb -U postgres <novo_banco>
printf "O banco de dados '<novo_banco>' foi criado.\n"
